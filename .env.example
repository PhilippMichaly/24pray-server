PORT=3001
# APP_URL = Basis der Magic-Links UND immer CORS-erlaubte Origin.
# MUSS exakt der Frontend-Host sein (kein :3002-Mismatch, sonst „Failed to fetch"). Siehe §6.5.
APP_URL=http://localhost:3000
# Optional: weitere CORS-Origins (Komma-Liste), z. B. Preview-Deployments. Entkoppelt von APP_URL.
# CORS_ORIGINS=https://preview.24pray.org,http://localhost:3002
CORS_ORIGINS=
DATA_DIR=./data
# Prisma resolves a relative file: URL against the prisma/ schema dir, so "../data"
# points at the same <repo>/data/24pray.db file the server uses (DATA_DIR above).
# In production use an absolute path, e.g. file:/opt/24pray-api/data/24pray.db
DATABASE_URL="file:../data/24pray.db"
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
# Leave SMTP_URL empty in dev — magic links are logged to the console.
SMTP_URL=
SMTP_FROM=24pray <no-reply@24pray.local>
# Nur lokal/E2E: /auth/magic-link liefert den Login-Link als {devLoginUrl} (Login ohne Postfach).
# NIE in Produktion setzen — mit COOKIE_SECURE=true oder https-APP_URL verweigert die API den Start.
DEV_LOGIN_RESPONSE=true
# Mit gesetztem SMTP_URL Pflicht (mind. 32 Zeichen): openssl rand -hex 32. Ohne SMTP gilt ein Dev-Default.
UNSUBSCRIBE_SECRET=
# Bind-Adresse; Default 127.0.0.1 (Loopback). Nur im Container 0.0.0.0.
# HOST=127.0.0.1
